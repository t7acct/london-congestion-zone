{
  "manifest_version": 3,
  "name": "London Congestion Zone for Google Maps",
  "version": "1.0.0",
  "description": "Outlines the London Congestion Charge zone on Google Maps and shows whether the charge is in effect right now.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://www.google.co.uk/maps*",
        "https://maps.google.com/*",
        "https://maps.google.co.uk/*"
      ],
      "js": ["zone.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
